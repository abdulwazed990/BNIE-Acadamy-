rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }
    match /leadership_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }
    match /curriculums/{curriculumId} {
      allow read: if true;
      allow write: if true;
    }
    match /homepage_content/{contentId} {
      allow read: if true;
      allow write: if true;
    }
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if true;
    }
    match /academic_programs/{programId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
